{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ScoreTranslate",
  "version": "0.2.0",
  "identifier": "io.github.tpnet.scoretranslate",
  "build": {
    "beforeDevCommand": "bun x --no-install vite",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  }
}
